   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Graphical abstract\n",
    "\n",
    "UMAP + cluster-coloring and pie-chart plots used for the paper's graphical abstract,\n",
    "extracted from `figure_5_main`. Run the imports + data-loading cells first."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "7e83fcfd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The autoreload extension is already loaded. To reload it, use:\n",
      "  %reload_ext autoreload\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import pickle\n",
    "import seaborn as sns\n",
    "\n",
    "sns.set_context('notebook', font_scale=1.5, rc={'lines.markeredgewidth': 1})\n",
    "\n",
    "# Visual behavior analysis package functions\n",
    "import visual_behavior.visualization.utils as utils\n",
    "import visual_behavior.data_access.loading as loading\n",
    "import visual_behavior.data_access.utilities as utilities\n",
    "\n",
    "# Clustering modules\n",
    "from visual_behavior.dimensionality_reduction.clustering import plotting\n",
    "from visual_behavior.dimensionality_reduction.clustering import processing\n",
    "\n",
    "# Platform paper figure functions\n",
    "import visual_behavior.visualization.ophys.platform_paper_figures as ppf\n",
    "import visual_behavior.visualization.ophys.platform_single_cell_examples as pse\n",
    "\n",
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "%matplotlib inline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "a2bdcf12",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Figure saving\n",
    "save_dir = os.path.join(loading.get_figures_save_dir(), 'platform_paper_figures', 'figure_5')\n",
    "os.makedirs(save_dir, exist_ok=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8734cf38",
   "metadata": {},
   "source": [
    "## Data Loading"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "be4700bd",
   "metadata": {},
   "source": [
    "#### Metadata tables"
   ]
